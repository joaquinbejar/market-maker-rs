    "glft": {"kind": "classical", "grid": {"risk_aversion": ["0.01", "0.1"], "order_intensity_k": ["0.3", "1"], "intensity_scale_a": ["1.5"], "max_inventory_lots": [20], "min_spread": ["0.01"], "volatility": ["0.05", "0.2"], "terminal_time": [86400000]}},
    "maskable_ppo": {
      "kind": "pure_rl",
      "grid": {"bid_offsets": [0, 1, 2, 4, 8], "ask_offsets": [0, 1, 2, 4, 8], "sizes": [1, 2]},
      "invalid_action": "mask",
      "hyperparameter_sets": [
        {"learning_rate": 0.0003, "n_steps": 2048, "batch_size": 256, "n_epochs": 5, "ent_coef": 0.0},
        {"learning_rate": 0.0001, "n_steps": 2048, "batch_size": 256, "n_epochs": 5, "ent_coef": 0.0},
        {"learning_rate": 0.0003, "n_steps": 2048, "batch_size": 256, "n_epochs": 5, "ent_coef": 0.01}
      ],
      "budget_steps": 2000000
    },
    "sac_residual_avellaneda_stoikov": {
      "kind": "residual_rl",
      "baseline": "the avellaneda_stoikov parameters selected on validation",
      "bounds": {"price_ticks": 4, "size_lots": 1},
      "invalid_action": "reject",
      "hyperparameter_sets": [
        {"learning_rate": 0.0003, "batch_size": 256, "buffer_size": 200000, "learning_starts": 5000, "tau": 0.005},
        {"learning_rate": 0.0001, "batch_size": 256, "buffer_size": 200000, "learning_starts": 5000, "tau": 0.005},
        {"learning_rate": 0.0003, "batch_size": 256, "buffer_size": 200000, "learning_starts": 5000, "tau": 0.02}
      ],
      "budget_steps": 500000
    },
    "sac_residual_glft": {"kind": "residual_rl", "conditional": "only if the budget holds after the AS residual", "baseline": "the glft parameters selected on validation", "same_as": "sac_residual_avellaneda_stoikov"}
  },
  "training_seeds": [1, 2, 3, 4, 5],
  "training_days": "each reset draws a training day uniformly from the run's seed",
  "steps": [
    {"name": "reduced", "regimes": ["calm"], "training_seeds": [1, 2], "budget_steps": 50000, "estimate_minutes": 15},
    {"name": "selection", "estimate_minutes": 90},
    {"name": "main", "estimate_minutes": 30},
    {"name": "ablations", "estimate_minutes": 120},
    {"name": "holdout", "estimate_minutes": 10}
  ],
  "compute": {"machine": "Apple M4 Max", "device": "cpu", "threads_per_run": 1, "max_parallel_runs": 6, "overrun_rule": "a step that overruns its estimate by more than 50 % stops and is reported, without cutting seeds"},
  "decision_rule": {
    "against": "the best classical arm on the holdout, avellaneda_stoikov or glft, by mean daily net",
    "interval": "90 % block bootstrap over days, on the paired daily difference",
    "continue": "the lower bound is above 0, there is no limit breach, and max drawdown is at most 1.2 times the classical arm's",
    "revise": "the point estimate is above 0 but the interval includes 0, or the drawdown condition fails",
    "discard": "otherwise",
    "applied": "per regime and pooled"
  }
}
